#!/usr/bin/gawk -E
# msed -- the msed language (see ../README.md), interpreted in awk.
#
#     cat infile | ./msed '<program>' [arguments...]
#
# Part 1 translates the program into a sed script and lets sed run it.
# This version does not use sed at all: it parses the program into a
# table of commands and runs them itself, keeping the pattern space, the
# hold space and the t flag in awk variables.  Input is read with
# getline, one line ahead (more for $-N), so the last line is known.
#
# Needs GNU awk: gensub(), RT and IGNORECASE.
#
# Layout:
#   1. reading the program   (parse_program and the scan_* helpers)
#   2. sed regex -> awk regex (bre2ere)
#   3. replacement and text escapes
#   4. input and output      (the lookahead buffer, missing newlines)
#   5. addresses             (addr_match)
#   6. running a cycle       (run)

BEGIN {
    # ARGV[1] is the program, ARGV[2..] its arguments.  Clearing ARGC
    # makes getline read standard input instead of treating them as files.
    if (ARGC < 2) {
        print "usage: msed '<program>' [arguments...]" > "/dev/stderr"
        exit 1
    }
    nargv = ARGC - 1
    for (k = 1; k < ARGC; k++) argv[k] = ARGV[k]
    ARGC = 1

    for (k = 1; k < 256; k++) ORD[sprintf("%c", k)] = k

    parse_program(argv[1])
    exit run()
}

function fail(msg) {
    printf "msed: %s\n", msg > "/dev/stderr"
    exit 1
}

function parse_fail(msg) {
    fail("char " pos ": " msg)
}

# ===================================================================
# 1. Reading the program
# ===================================================================
#
# The program is in P; pos is the current character.  The grammar and
# the escape rules are the same as in part 1.  For every command c:
#
#   cmd[c]            the letter ({ and } included)
#   a1t[c] a1v[c]     first address: type and value; a2t a2v the second
#                     types: num last neg step zero re plus tilde
#   a1s[c]            step of first~step
#   are[c,n] aic[c,n] regex and I flag of address n
#   neg[c]            1 if followed by !
#   txt[c]            text of a i c C, file name of w W r R
#   lab[c]            label of : b t T;  jmp[c] index it jumps to
#   blkend[c]         for {, the index of its }
#   sre sic sg snth sp swf   s: regex, I flag, g, number, p, w file
#   rsn rsp rsg rsb rsm  s: replacement segments (see parse_repl)
#   ysrc[c] ydst[c]   y
#   num[c]            number after q Q l

function ch(i) { return substr(P, i, 1) }
function isdigit(x) { return x ~ /^[0-9]$/ }
function isblank(x) { return x == " " || x == "\t" }

function skip_blanks() { while (isblank(ch(pos))) pos++ }

function read_number(   v) {
    v = 0
    while (isdigit(ch(pos))) { v = v * 10 + ch(pos); pos++ }
    return v
}

# $N at pos.  Returns the argument and leaves pos after the digits.
function read_param(   n) {
    pos++
    n = read_number()
    return (n >= 1 && n <= nargv) ? argv[n] : ""
}

# $N where an address or a command is expected: put the value into the
# program text and read it from there.
function splice_param(   start, v) {
    if (++splices > 100) parse_fail("argument substitution does not terminate")
    start = pos
    v = read_param()
    P = substr(P, 1, start - 1) v substr(P, pos)
    pos = start
}

function at_param() { return ch(pos) == "$" && isdigit(ch(pos + 1)) }

# The body of /re/, s/re/repl/ or y/src/dst/ up to the delimiter dl.
# A backslash and the next character stay together, so \; \$ and \dl
# never end the field.  $N is copied in with dl and newlines escaped.
function scan_field(dl,    out, c, v, k) {
    out = ""
    while (1) {
        c = ch(pos)
        if (c == "") parse_fail("unterminated regex, s or y command")
        if (c == "\\") {
            if (ch(pos + 1) == "") parse_fail("unterminated regex, s or y command")
            out = out ((ch(pos + 1) == "\n") ? "\\n" : "\\" ch(pos + 1))
            pos += 2
        } else if (c == dl) {
            pos++
            return out
        } else if (at_param()) {
            v = read_param()
            for (k = 1; k <= length(v); k++) {
                c = substr(v, k, 1)
                if (c == dl) out = out "\\" c
                else if (c == "\n") out = out "\\n"
                else out = out c
            }
        } else if (c == "\n") {
            out = out "\\n"; pos++
        } else {
            out = out c; pos++
        }
    }
}

# Argument of a i c C (tmode "text") or w W r R (tmode "file"), up to an
# unescaped ; or a newline, which are left in place.
# For "text" the result still has sed's escapes in it (\t, \\, ...);
# textproc() resolves them.  \; and \$ are resolved here.
function scan_text(tmode,    out, c, d, v, k) {
    skip_blanks()
    if (ch(pos) == "\\") {
        d = ch(pos + 1)
        if (d == "\n") pos += 2
        else if (d != ";" && d != "$" && d != "") pos++
    }
    out = ""
    while (1) {
        c = ch(pos)
        if (c == "" || c == ";" || c == "\n") return out
        if (c == "\\") {
            d = ch(pos + 1)
            if (d == "") { out = out ((tmode == "file") ? "\\" : "\\\\"); pos++; continue }
            if (d == ";" || d == "$") out = out d
            else if (tmode == "file" && d == "\\") out = out "\\"
            else out = out "\\" d
            pos += 2
        } else if (at_param()) {
            v = read_param()
            for (k = 1; k <= length(v); k++) {
                c = substr(v, k, 1)
                out = out ((c == "\n" && tmode != "file") ? "\\\n" : c)
            }
        } else {
            out = out c; pos++
        }
    }
}

function scan_label(   out) {
    skip_blanks()
    out = ""
    while (ch(pos) != "" && ch(pos) !~ /[; \t\n}]/) { out = out ch(pos); pos++ }
    return out
}

# One address, for command c, slot n (1 or 2).  Returns 0 if there is none.
function parse_addr(c, n,    x, dl, v) {
    while (at_param()) splice_param()
    if (n == 2) skip_blanks()
    x = ch(pos)
    if (isdigit(x)) {
        v = read_number()
        if (ch(pos) == "~" && isdigit(ch(pos + 1)) && n == 1) {
            pos++
            set_addr(c, n, "step", v)
            a1s[c] = read_number()
            if (v == 0 && a1s[c] == 0) parse_fail("invalid usage of line address 0")
        } else if (v == 0 && n == 1) {
            set_addr(c, n, "zero", 0)
        } else {
            set_addr(c, n, "num", v)
        }
        return 1
    }
    if (x == "$") {
        if (ch(pos + 1) == "-" && isdigit(ch(pos + 2))) {
            pos += 2
            set_addr(c, n, "neg", read_number())
            if (negmax < addrv) negmax = addrv
        } else {
            pos++
            set_addr(c, n, "last", 0)
        }
        return 1
    }
    if (x == "/" || x == "\\") {
        if (x == "\\") {
            pos++
            dl = ch(pos)
            if (dl == "" || dl == "\n") parse_fail("unexpected end of program after a backslash")
        } else dl = "/"
        pos++
        set_addr(c, n, "re", 0)
        are[c, n] = bre2ere(scan_field(dl), dl)
        aic[c, n] = 0
        while (ch(pos) == "I" || ch(pos) == "M") {
            if (ch(pos) == "M") parse_fail("the M flag is not supported")
            aic[c, n] = 1
            pos++
        }
        return 1
    }
    if (n == 2 && (x == "+" || x == "~")) {
        pos++
        if (!isdigit(ch(pos))) parse_fail("expected a number after " x)
        set_addr(c, n, (x == "+") ? "plus" : "tilde", read_number())
        return 1
    }
    if (n == 2) parse_fail("unexpected ,")
    return 0
}

function set_addr(c, n, t, v) {
    addrv = v
    if (n == 1) { a1t[c] = t; a1v[c] = v } else { a2t[c] = t; a2v[c] = v }
}

# Text commands, file names and labels end at ; or a newline.  Any other
# command must be followed by one of ; newline } # or the end.
function end_command(   x) {
    skip_blanks()
    x = ch(pos)
    if (x != "" && x != ";" && x != "\n" && x != "}" && x != "#")
        parse_fail("extra characters after command")
}

function parse_program(prog,    c, x, dl, raw, depth, k, j, ok) {
    P = prog
    pos = 1
    ncmd = 0
    depth = 0
    nflag = 0
    negmax = 0
    # "#n" as the very first line works like sed -n
    if (substr(P, 1, 2) == "#n" && (length(P) == 2 || substr(P, 3, 1) == "\n"))
        nflag = 1

    while (1) {
        while (at_param()) splice_param()
        x = ch(pos)
        if (x == "") break
        if (x ~ /[ \t\n;]/) { pos++; continue }

        c = ++ncmd
        a1t[c] = ""; a2t[c] = ""; neg[c] = 0
        if (parse_addr(c, 1)) {
            skip_blanks()
            if (ch(pos) == ",") {
                pos++
                parse_addr(c, 2)
            }
        }
        if (a1t[c] == "zero" && a2t[c] != "re")
            parse_fail("invalid usage of line address 0")
        if (a1t[c] == "zero") rst[c] = "active"   # 0,/re/: the range is open before line 1
        skip_blanks()
        while (ch(pos) == "!") {
            if (neg[c]) parse_fail("multiple !s")
            neg[c] = 1
            pos++
            skip_blanks()
        }
        while (at_param()) splice_param()

        x = ch(pos)
        if (x == "" || x == ";" || x == "\n") parse_fail("missing command")
        pos++
        cmd[c] = x

        if (x == "{") {
            stack[++depth] = c
            continue
        }
        if (x == "}") {
            if (a1t[c] != "") parse_fail("} does not want any addresses")
            if (depth == 0) parse_fail("unexpected }")
            blkend[stack[depth--]] = c
            end_command()
            continue
        }
        if (x == "#") {
            while (ch(pos) != "" && ch(pos) != "\n") pos++
            ncmd--
            continue
        }
        if (x == ":") {
            if (a1t[c] != "") parse_fail(": does not want any addresses")
            lab[c] = scan_label()
            if (lab[c] == "") parse_fail("\":\" lacks a label")
            end_command()
            continue
        }
        if (x ~ /^[btT]$/) { lab[c] = scan_label(); end_command(); continue }
        if (x == "v") { scan_label(); ncmd--; end_command(); continue }

        if (x == "s") {
            dl = ch(pos)
            if (dl == "" || dl == "\n" || dl == "\\") parse_fail("unterminated `s' command")
            pos++
            raw = scan_field(dl)
            sre[c] = (raw == "") ? "" : bre2ere(raw, dl)
            parse_repl(c, scan_field(dl), dl)
            sg[c] = 0; snth[c] = 1; sp[c] = 0; sic[c] = 0; swf[c] = ""
            ok = 0
            while (1) {
                x = ch(pos)
                if (x == "g") sg[c] = 1
                else if (x == "p") sp[c] = 1
                else if (x == "i" || x == "I") sic[c] = 1
                else if (x == "m" || x == "M") parse_fail("the M flag is not supported")
                else if (x == "e") parse_fail("the e flag is not supported")
                else if (isdigit(x)) {
                    snth[c] = read_number()
                    if (snth[c] == 0) parse_fail("number option to `s' command may not be zero")
                    continue
                }
                else if (x == "w") {
                    pos++
                    swf[c] = scan_text("file")
                    open_wfile(swf[c])
                    ok = 1
                    break
                }
                else break
                pos++
            }
            if (!ok) end_command()
            continue
        }
        if (x == "y") {
            dl = ch(pos)
            if (dl == "" || dl == "\n" || dl == "\\") parse_fail("unterminated `y' command")
            pos++
            ysrc[c] = yproc(scan_field(dl), dl)
            ydst[c] = yproc(scan_field(dl), dl)
            if (length(ysrc[c]) != length(ydst[c]))
                parse_fail("strings for `y' command are different lengths")
            end_command()
            continue
        }
        if (x ~ /^[aicC]$/) {
            txt[c] = textproc(scan_text("text"))
            continue
        }
        if (x ~ /^[wWrR]$/) {
            txt[c] = scan_text("file")
            if (txt[c] == "") parse_fail("missing filename in r/R/w/W commands")
            if (x ~ /[wW]/) open_wfile(txt[c])
            continue
        }
        if (x ~ /^[qQlL]$/) {
            skip_blanks()
            num[c] = isdigit(ch(pos)) ? read_number() : -1
            if (x ~ /[qQ]/ && a2t[c] != "") parse_fail("command only uses one address")
            end_command()
            continue
        }
        if (x ~ /^[dDgGhHxnNpPz=fFZ]$/) { end_command(); continue }
        if (x == "e") parse_fail("the e command is not supported")
        pos--
        parse_fail("unknown command: `" x "'")
    }
    if (depth > 0) { pos = length(P); parse_fail("unmatched `{'") }

    # labels
    for (c = 1; c <= ncmd; c++) {
        if (cmd[c] !~ /^[btT]$/) continue
        if (lab[c] == "") { jmp[c] = ncmd + 1; continue }
        jmp[c] = 0
        for (j = 1; j <= ncmd; j++)
            if (cmd[j] == ":" && lab[j] == lab[c]) { jmp[c] = j; break }
        if (!jmp[c]) fail("can't find label for jump to `" lab[c] "'")
    }

    # $-N needs N+1 lines of lookahead; $ needs one
    lookahead = negmax + 1
}

function open_wfile(f) {
    if (f == "/dev/stdout" || f == "/dev/stderr" || (f in wopen)) return
    wopen[f] = 1
    printf "" > f
}

# ===================================================================
# 2. sed regex (GNU basic regular expression) -> awk regex (ERE)
# ===================================================================
#
# What changes between the two:
#   \( \) \{ \} \| \+ \?    are operators in sed, plain ( ) { } | + ? in awk
#   ( ) { } | + ?           are literal in sed, so they get a backslash
#   ^ $ *                   are literal in sed when not in an anchoring
#                           or repeating position
#   \n \t                   become the characters themselves
#   \b                      word boundary in sed, \y in gawk
# Back-references (\1 in the regex itself) have no awk equivalent.

function ere_quote(x) {
    return (x ~ /[][\\^$.|()*+?{}]/) ? "\\" x : x
}

function bre2ere(s, dl,    t, i, n, c, d, out, atstart, q, k) {
    # Like sed: \dl becomes dl itself and \n a newline before compiling.
    t = ""
    n = length(s)
    for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (c == "\\" && i < n) {
            d = substr(s, i + 1, 1)
            if (d == dl) t = t d
            else if (d == "n") t = t "\n"
            else t = t c d
            i++
        } else t = t c
    }
    s = t
    n = length(s)
    out = ""
    atstart = 1
    i = 1
    while (i <= n) {
        c = substr(s, i, 1)
        if (c == "\\") {
            d = substr(s, i + 1, 1)
            i += 2
            if (d == "(") { out = out "("; atstart = 1; continue }
            if (d == "|") { out = out "|"; atstart = 1; continue }
            atstart = 0
            if (d == ")") out = out ")"
            else if (d == "{") {
                q = ""
                while (i <= n && substr(s, i, 2) != "\\}") { q = q substr(s, i, 1); i++ }
                if (i > n) fail("unmatched \\{")
                i += 2
                out = out "{" q "}"
            }
            else if (d == "+" || d == "?") out = out d
            else if (d ~ /[1-9]/) fail("back-references inside a regex are not supported")
            else if (d == "t") out = out "\t"
            else if (d == "f") out = out "\f"
            else if (d == "v") out = out "\v"
            else if (d == "a") out = out "\007"
            else if (d == "r") out = out "\r"
            else if (d ~ /[wWsS<>`'B]/) out = out "\\" d
            else if (d == "b") out = out "\\y"
            else if (d ~ /[cdox]/) { out = out ere_quote(num_escape(s, i - 2)); i = epos }
            else out = out ere_quote(d)
            continue
        }
        if (c == "[") {
            out = out bracket(s, i)
            i = epos
            atstart = 0
            continue
        }
        if (c == "^") {
            out = out (atstart ? "^" : "\\^")
            i++
            continue
        }
        if (c == "$") {
            q = substr(s, i + 1, 2)
            out = out ((i == n || q == "\\)" || q == "\\|") ? "$" : "\\$")
            i++
            atstart = 0
            continue
        }
        if (c == "*") {
            out = out (atstart ? "\\*" : "*")
            i++
            atstart = 0
            continue
        }
        out = out ((c ~ /[+?(){}|]/) ? "\\" c : c)
        atstart = 0
        i++
    }
    return out
}

# A bracket expression starting at s[i] (the "["); sets epos past the "]".
# Inside it sed reads \n \t \\ as escapes and any other backslash
# literally, while awk treats every backslash as an escape.
function bracket(s, i,    j, n, out, c, d, k) {
    n = length(s)
    j = i + 1
    out = "["
    if (substr(s, j, 1) == "^") { out = out "^"; j++ }
    if (substr(s, j, 1) == "]") { out = out "\\]"; j++ }
    while (j <= n) {
        c = substr(s, j, 1)
        if (c == "]") { epos = j + 1; return out "]" }
        if (c == "[" && substr(s, j + 1, 1) ~ /[:.=]/) {
            d = substr(s, j + 1, 1)
            k = index(substr(s, j + 2), d "]")
            if (k == 0) fail("unterminated [" d)
            out = out substr(s, j, k + 3)
            j += k + 3
            continue
        }
        if (c == "\\") {
            d = substr(s, j + 1, 1)
            if (d == "t") { out = out "\t"; j += 2; continue }
            if (d == "\\") { out = out "\\\\"; j += 2; continue }
            if (d == "]") { out = out "\\\\"; j++; continue }
            out = out "\\\\"
            j++
            continue
        }
        if (c == "[") { out = out "\\["; j++; continue }
        out = out c
        j++
    }
    fail("unterminated address regex")
}

# \cX \dNNN \oNNN \xHH at s[i]; returns the character, sets epos.
function num_escape(s, i,    d, j, v, x, k, base, maxd, digits) {
    d = substr(s, i + 1, 1)
    j = i + 2
    if (d == "c") {
        x = toupper(substr(s, j, 1))
        epos = j + 1
        return sprintf("%c", xor(ORD[x], 64))
    }
    if (d == "d") { base = 10; maxd = 3; digits = "0123456789" }
    else if (d == "o") { base = 8; maxd = 3; digits = "01234567" }
    else { base = 16; maxd = 2; digits = "0123456789abcdef" }
    v = 0
    for (k = 0; k < maxd; k++) {
        x = index(digits, tolower(substr(s, j, 1)))
        if (x == 0) break
        v = v * base + x - 1
        j++
    }
    epos = j
    if (k == 0) return d
    return sprintf("%c", v)
}

# ===================================================================
# 3. Replacement and text escapes
# ===================================================================

# s replacement -> segments, the way GNU sed stores it.  Each segment is
# literal text (rsp), then a group (rsg: 0-9, or -1 for none), with a case
# mode (rsb: "", L or U) and a one-letter modifier (rsm: "", l or u).
# A group or a case escape (\L \U \E \l \u) ends the current segment.
function parse_repl(c, s, dl,    n, k, x, d, lit, base, mod) {
    n = 0
    k = 1
    lit = ""
    base = ""
    mod = ""
    while (k <= length(s)) {
        x = substr(s, k, 1)
        if (x == "\\") {
            d = substr(s, k + 1, 1)
            if (d ~ /^[0-9]$/) {
                n++; rsp[c, n] = lit; rsg[c, n] = d + 0; rsb[c, n] = base; rsm[c, n] = mod
                lit = ""; mod = ""
                k += 2
                continue
            }
            if (d ~ /^[LUElu]$/) {
                n++; rsp[c, n] = lit; rsg[c, n] = -1; rsb[c, n] = base; rsm[c, n] = mod
                lit = ""; mod = ""
                if (d == "E") base = ""
                else if (d == "L" || d == "U") base = d
                else mod = d
                k += 2
                continue
            }
            if (d == "n") lit = lit "\n"
            else if (d == "t") lit = lit "\t"
            else if (d == "a") lit = lit "\007"
            else if (d == "f") lit = lit "\f"
            else if (d == "v") lit = lit "\v"
            else if (d == "r") lit = lit "\r"
            else if (d ~ /[cdox]/) { lit = lit num_escape(s, k); k = epos; continue }
            else lit = lit d
            k += 2
            continue
        }
        if (x == "&") {
            n++; rsp[c, n] = lit; rsg[c, n] = 0; rsb[c, n] = base; rsm[c, n] = mod
            lit = ""; mod = ""
            k++
            continue
        }
        lit = lit x
        k++
    }
    n++; rsp[c, n] = lit; rsg[c, n] = -1; rsb[c, n] = base; rsm[c, n] = mod
    rsn[c] = n
}

# Text of a i c C, as sed reads it: \t \n ... and \X -> X.
function textproc(s,    out, k, x, d) {
    out = ""
    k = 1
    while (k <= length(s)) {
        x = substr(s, k, 1)
        if (x != "\\") { out = out x; k++; continue }
        d = substr(s, k + 1, 1)
        if (d == "t") out = out "\t"
        else if (d == "n") out = out "\n"
        else if (d == "a") out = out "\007"
        else if (d == "f") out = out "\f"
        else if (d == "v") out = out "\v"
        else if (d == "r") out = out "\r"
        else if (d ~ /[cdox]/) { out = out num_escape(s, k); k = epos; continue }
        else out = out d
        k += 2
    }
    return out
}

# y strings: \dl, \\, \n, \t ... -> the character
function yproc(s, dl,    out, k, x, d) {
    out = ""
    k = 1
    while (k <= length(s)) {
        x = substr(s, k, 1)
        if (x != "\\") { out = out x; k++; continue }
        d = substr(s, k + 1, 1)
        if (d == "n") out = out "\n"
        else if (d == "t") out = out "\t"
        else out = out d
        k += 2
    }
    return out
}

# ===================================================================
# 4. Input and output
# ===================================================================
#
# buf[1..nbuf] holds lines read ahead with getline; bufc[] says whether
# each ended with a newline (RT).  ineof is set once getline hits EOF.

function fill(   ln, r) {
    while (nbuf < lookahead && !ineof) {
        r = getline ln
        if (r > 0) { nbuf++; buf[nbuf] = ln; bufc[nbuf] = (RT != "") }
        else ineof = 1
    }
}

# Next input line into NLT (and NLC); 0 at the end of input.
function next_line(   k) {
    fill()
    if (nbuf == 0) return 0
    NLT = buf[1]
    NLC = bufc[1]
    for (k = 1; k < nbuf; k++) { buf[k] = buf[k + 1]; bufc[k] = bufc[k + 1] }
    delete buf[nbuf]
    delete bufc[nbuf]
    nbuf--
    linenum++
    flag = 0
    fill()
    return 1
}

# Lines after the current one, when the end is near enough to know.
function remaining() { return ineof ? nbuf : 1000000000 }
function at_eof() { return remaining() == 0 }

# sed remembers when the last line had no newline and prints it without
# one; anything printed after it gets the newline first.
function out_text(s) {
    if (missnl) { printf "\n"; missnl = 0 }
    printf "%s", s
}

function out_ps(s, chomp) {
    out_text(s)
    if (chomp) printf "\n"
    else missnl = 1
}

function write_file(f, s, chomp) {
    if (f == "/dev/stdout") { out_ps(s, chomp); return }
    if (wmiss[f]) { printf "\n" > f; wmiss[f] = 0 }
    printf "%s", s > f
    if (chomp) printf "\n" > f
    else wmiss[f] = 1
    fflush(f)
}

function queue(kind, s) { qk[++nq] = kind; qv[nq] = s }

function dump_append(   k, ln, f) {
    for (k = 1; k <= nq; k++) {
        if (qk[k] == "text") { out_text(qv[k]); continue }
        f = qv[k]
        while ((getline ln < f) > 0) out_text(ln RT)
        close(f)
    }
    nq = 0
}

function list_ps(width,    out, k, x, e, w, col) {
    out = ""
    col = 0
    if (width < 0) width = 70
    width--
    for (k = 1; k <= length(PS); k++) {
        x = substr(PS, k, 1)
        if (x == "\\") e = "\\\\"
        else if (x == "\007") e = "\\a"
        else if (x == "\b") e = "\\b"
        else if (x == "\f") e = "\\f"
        else if (x == "\n") e = "\\n"
        else if (x == "\r") e = "\\r"
        else if (x == "\t") e = "\\t"
        else if (x == "\v") e = "\\v"
        else if (ORD[x] < 32 || ORD[x] >= 127) e = sprintf("\\%03o", ORD[x])
        else e = x
        w = length(e)
        if (col + w > width && width > 0) { out = out "\\\n"; col = 0 }
        out = out e
        col += w
    }
    return out "$\n"
}

# ===================================================================
# 5. Addresses
# ===================================================================
#
# addr_match(c) also sets mid: 1 while c is inside a range that is still
# open after this line (c prints its text only when a range closes).
#
# Ranges follow GNU sed, including what happens when a command is not
# reached on every line (because of b, N, D ...):
#   - a numeric first address starts the range on the first line at or
#     after it, but only once;
#   - a numeric end that has already gone by matches nothing more;
#   - addr,+N and addr,~N stop at the first line at or after their end.
# rst[c] is "" (never active), "active" or "closed".

function one_match(c, n,    t, v) {
    t = (n == 1) ? a1t[c] : a2t[c]
    v = (n == 1) ? a1v[c] : a2v[c]
    if (t == "num") return linenum == v
    if (t == "last") return at_eof()
    if (t == "neg") return remaining() == v
    if (t == "re") return re_match(PS, are[c, n], aic[c, n])
    if (t == "step") {
        if (a1s[c] <= 0) return linenum == v
        return linenum >= v && (linenum - v) % a1s[c] == 0
    }
    return 0
}

function re_match(s, re, ic,    r) {
    if (re == "") {
        if (!haslast) fail("no previous regular expression")
        re = lastre; ic = lastic
    } else { lastre = re; lastic = ic; haslast = 1 }
    IGNORECASE = ic
    r = (s ~ re)
    IGNORECASE = 0
    return r
}

# For $-N, "line >= total-N" is "at most N lines remain".
# Numeric first address: line >= a1 (a $-N before line 1 never starts).
function start_reached(c,    r) {
    if (a1t[c] == "num") return linenum >= a1v[c]
    r = remaining()
    return r <= a1v[c] && linenum + r >= a1v[c] + 1
}
# Numeric second address: line >= a2, and line <= a2.
function end_reached(c) {
    if (a2t[c] == "num") return linenum >= a2v[c]
    return remaining() <= a2v[c]
}
function end_not_passed(c) {
    if (a2t[c] == "num") return linenum <= a2v[c]
    return remaining() >= a2v[c]
}

function addr_match(c,    t, r) {
    mid = 0
    if (a1t[c] == "") return 1
    if (a2t[c] == "") return one_match(c, 1)
    t = a2t[c]

    if (rst[c] == "active") {
        if (t == "num" || t == "neg") {
            r = end_not_passed(c)
            if (end_reached(c)) rst[c] = "closed"
            else mid = 1
            return r
        }
        if (t == "plus" || t == "tilde") {
            if (linenum >= rend[c]) rst[c] = "closed"
            else mid = 1
            return 1
        }
        if (one_match(c, 2)) rst[c] = "closed"
        else mid = 1
        return 1
    }

    # Not inside the range: does it start on this line?
    if (a1t[c] == "num" || a1t[c] == "neg") {
        if (rst[c] == "closed" || !start_reached(c)) return 0
    } else if (!one_match(c, 1)) return 0

    if (t == "num" || t == "neg") {
        if (end_reached(c)) {
            rst[c] = "closed"
            return end_not_passed(c) || one_match(c, 1)
        }
    } else if (t == "plus" || t == "tilde") {
        if (t == "plus") rend[c] = linenum + a2v[c]
        else rend[c] = (a2v[c] > 0) ? (int(linenum / a2v[c]) + 1) * a2v[c] : linenum
        if (linenum >= rend[c]) { rst[c] = "closed"; return 1 }
    } else if (t == "last" && at_eof()) {
        rst[c] = "closed"
        return 1
    }
    # a regex or $ end is first tried on the next line
    rst[c] = "active"
    mid = 1
    return 1
}

# ===================================================================
# 6. Running
# ===================================================================

function do_subst(c,    re, ic, A, B, C, t, res, k, pa, pc, inner, g, n, did, take) {
    re = sre[c]
    ic = sic[c]
    if (re == "") {
        if (!haslast) fail("no previous regular expression")
        re = lastre; ic = lastic
    } else { lastre = re; lastic = ic; haslast = 1 }

    # gensub marks every match: A match B group1 B ... group9 C, using
    # control characters that do not occur in the pattern space.
    A = B = C = ""
    for (k = 1; k < 32 && C == ""; k++) {
        if (k == 9 || k == 10) continue
        t = sprintf("%c", k)
        if (index(PS, t)) continue
        if (A == "") A = t
        else if (B == "") B = t
        else C = t
    }
    if (C == "") fail("pattern space uses every control character")
    IGNORECASE = ic
    t = gensub(re, A "\\0" B "\\1" B "\\2" B "\\3" B "\\4" B "\\5" B "\\6" B "\\7" B "\\8" B "\\9" C, "g", PS)
    IGNORECASE = 0
    if (!index(t, A)) return

    res = ""
    k = 0
    did = 0
    while ((pa = index(t, A)) > 0) {
        res = res substr(t, 1, pa - 1)
        t = substr(t, pa + 1)
        pc = index(t, C)
        inner = substr(t, 1, pc - 1)
        t = substr(t, pc + 1)
        split(inner, g, B)
        k++
        take = sg[c] ? (k >= snth[c]) : (k == snth[c])
        if (take) { res = res build_repl(c, g); did = 1 }
        else res = res g[1]
    }
    if (!did) return
    PS = res t
    flag = 1
    if (sp[c]) out_ps(PS, chomped)
    if (swf[c] != "") write_file(swf[c], PS, chomped)
}

# The replacement for one match; g[1] is the match, g[2..10] groups 1-9.
# A \l or \u in front of an empty group carries over to the next segment.
function build_repl(c, g,    j, s, mod, pend, grp) {
    s = ""
    pend = ""
    for (j = 1; j <= rsn[c]; j++) {
        mod = (rsm[c, j] != "") ? rsm[c, j] : pend
        pend = ""
        if (rsp[c, j] != "") {
            s = s case_text(rsp[c, j], rsb[c, j], mod)
            mod = ""
        }
        if (rsg[c, j] >= 0) {
            grp = g[rsg[c, j] + 1]
            if (grp == "" && rsm[c, j] != "") pend = mod
            else if (grp != "") s = s case_text(grp, rsb[c, j], mod)
        }
    }
    return s
}

function case_text(t, base, mod,    first) {
    first = substr(t, 1, 1)
    t = substr(t, 2)
    if (base == "L") { first = tolower(first); t = tolower(t) }
    if (base == "U") { first = toupper(first); t = toupper(t) }
    if (mod == "l") first = tolower(first)
    if (mod == "u") first = toupper(first)
    return first t
}

function do_y(c,    out, k, x, p) {
    out = ""
    for (k = 1; k <= length(PS); k++) {
        x = substr(PS, k, 1)
        p = index(ysrc[c], x)
        out = out (p ? substr(ydst[c], p, 1) : x)
    }
    PS = out
}

# Runs the whole input.  Returns the exit status.
function run(   restart, pc, c, x, m, endmode, k, t, tc, ln) {
    HS = ""
    hchomped = 1
    restart = 0
    while (1) {
        if (!restart) {
            if (!next_line()) break
            PS = NLT
            chomped = NLC
        }
        restart = 0
        endmode = "auto"
        pc = 1
        while (pc <= ncmd) {
            c = pc++
            x = cmd[c]
            if (x == "}" || x == ":") continue
            m = addr_match(c)
            if (neg[c]) m = !m
            if (!m) {
                if (x == "{") pc = blkend[c] + 1
                continue
            }
            if (x == "{") continue

            if (x == "s") do_subst(c)
            else if (x == "p") out_ps(PS, chomped)
            else if (x == "d") { endmode = "delete"; break }
            else if (x == "D") {
                k = index(PS, "\n")
                if (!k) { endmode = "delete"; break }
                PS = substr(PS, k + 1)
                endmode = "restart"
                break
            }
            else if (x == "n") {
                if (at_eof()) break
                if (!nflag) out_ps(PS, chomped)
                dump_append()
                next_line()
                PS = NLT
                chomped = NLC
            }
            else if (x == "N") {
                if (at_eof()) break
                dump_append()
                next_line()
                PS = PS "\n" NLT
                chomped = NLC
            }
            else if (x == "g") { PS = HS; chomped = hchomped }
            else if (x == "G") { PS = PS "\n" HS; chomped = hchomped }
            else if (x == "h") { HS = PS; hchomped = chomped }
            else if (x == "H") { HS = HS "\n" PS; hchomped = chomped }
            else if (x == "x") {
                t = PS; PS = HS; HS = t
                tc = chomped; chomped = hchomped; hchomped = tc
            }
            else if (x == "b") pc = jmp[c]
            else if (x == "t") { if (flag) { flag = 0; pc = jmp[c] } }
            else if (x == "T") { if (!flag) pc = jmp[c]; else flag = 0 }
            else if (x == "a") queue("text", txt[c] "\n")
            else if (x == "i") out_text(txt[c] "\n")
            else if (x == "c") {
                if (!mid) out_text(txt[c] "\n")
                endmode = "delete"
                break
            }
            else if (x == "=") out_text(linenum "\n")
            else if (x == "P") {
                k = index(PS, "\n")
                if (k) out_text(substr(PS, 1, k))
                else out_ps(PS, chomped)
            }
            else if (x == "l") out_text(list_ps(num[c]))
            else if (x == "q") {
                if (!nflag) out_text(PS "\n")
                dump_append()
                return (num[c] < 0) ? 0 : num[c]
            }
            else if (x == "Q") return (num[c] < 0) ? 0 : num[c]
            else if (x == "r") queue("file", txt[c])
            else if (x == "R") {
                if ((getline ln < txt[c]) > 0) queue("text", ln RT)
            }
            else if (x == "w") write_file(txt[c], PS, chomped)
            else if (x == "W") {
                k = index(PS, "\n")
                if (k) write_file(txt[c], substr(PS, 1, k - 1), 1)
                else write_file(txt[c], PS, chomped)
            }
            else if (x == "y") do_y(c)
            else if (x == "z") PS = ""
            # the msed commands
            else if (x == "f") flag = 1
            else if (x == "F") flag = 0
            else if (x == "Z") {
                k = index(PS, "\n")
                PS = k ? substr(PS, k + 1) : ""
            }
            else if (x == "C") PS = txt[c]
        }

        if (endmode == "restart") { restart = 1; continue }
        if (endmode == "auto" && !nflag) out_ps(PS, chomped)
        dump_append()
    }
    return 0
}
